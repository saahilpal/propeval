        <!-- STAGE 1: Telephony Simulation & Fault Injection -->
        <mxCell id="stage1" value="&lt;b style='color:#38BDF8;'&gt;STAGE 1: HINGLISH TELEPHONY CONVERSATION SIMULATOR&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#38BDF8;strokeWidth=2;fontColor=#F8FAFC;rounded=1;arcSize=6;collapsible=0;" vertex="1" parent="1">
