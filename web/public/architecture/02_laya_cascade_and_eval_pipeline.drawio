        <!-- Title Block -->
        <mxCell id="title" value="&lt;b style='font-size:20px; color:#F8FAFC;'&gt;PropEval: Laya Cascade &amp;amp; 3-Layer Evaluation Pipeline&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px; color:#94A3B8;'&gt;8 kHz Hinglish ASR Simulator • Microsecond CPU Interceptor • System-1 Gating (τ_H=0.85, τ_L=0.15) • System-2 Escalation • Paired Stats&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=1;fillColor=#1E293B;strokeColor=#334155;strokeWidth=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1320" height="50" as="geometry" />
