        <!-- Stage 3 (Escalation) to Stage 4 -->
        <mxCell id="e3_4" value="Escalate 7.94%" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#EC4899;strokeWidth=2;fontColor=#EC4899;fontSize=11;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" source="stage3" target="stage4" parent="1">
          <mxGeometry relative="1" as="geometry" />
