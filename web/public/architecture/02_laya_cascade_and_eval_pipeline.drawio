        <!-- Stage 3 (Direct) to Stage 5 -->
        <mxCell id="e3_5" value="Resolved 92.06%" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4ADE80;strokeWidth=2;fontColor=#4ADE80;fontSize=11;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" source="stage3" target="stage5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Stage 4 to Stage 5 -->
        <mxCell id="e4_5" value="System-2 Judgments" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#EC4899;strokeWidth=2;fontColor=#EC4899;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" source="stage4" target="stage5" parent="1">
          <mxGeometry relative="1" as="geometry" />
