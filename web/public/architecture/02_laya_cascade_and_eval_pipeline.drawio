        <mxCell id="sim_fsm" value="&lt;b&gt;BuyerAgendaFSM&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;Strict state machine driving buyer agenda&lt;br&gt;States: GREETING, BUDGET, CONFIG,&lt;br&gt;POSSESSION, RERA_CHECK, DNC, CLOSE&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#334155;fontColor=#F8FAFC;align=left;spacingLeft=10;" vertex="1" parent="stage1">
          <mxGeometry x="15" y="40" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sim_realizer" value="&lt;b&gt;Indian Hinglish Realizer&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;Natural code-switching engine&lt;br&gt;&lt;i&gt;&quot;1.2 cr chalega, possession 2026 tak chahiye&quot;&lt;/i&gt;&lt;br&gt;Num: &quot;dedh crore&quot;, &quot;25 lakh&quot;, &quot;१.५ करोड़&quot;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#334155;fontColor=#F8FAFC;align=left;spacingLeft=10;" vertex="1" parent="stage1">
          <mxGeometry x="15" y="125" width="270" height="75" as="geometry" />
        </mxCell>
        <mxCell id="sim_asr" value="&lt;b&gt;8 kHz ASR Acoustic Perturbation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;Phoneme confusion matrix:&lt;br&gt;• crore ➔ core / kor / roar&lt;br&gt;• lakh ➔ lack / lock / look&lt;br&gt;• bhk ➔ vhk / dhk / bk&lt;br&gt;Simulates telephony audio artifacts&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0284C7;strokeWidth=1;fontColor=#38BDF8;align=left;spacingLeft=10;" vertex="1" parent="stage1">
          <mxGeometry x="15" y="215" width="270" height="95" as="geometry" />
        </mxCell>
        <mxCell id="sim_env" value="&lt;b&gt;MockRealEstateEnv Faults&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;Simulated CRM HTTP 503 / 504 timeouts&lt;br&gt;Tool slot desync &amp;amp; schema contract probes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#334155;fontColor=#F8FAFC;align=left;spacingLeft=10;" vertex="1" parent="stage1">
          <mxGeometry x="15" y="325" width="270" height="75" as="geometry" />
        </mxCell>

        <!-- STAGE 2: Microsecond Interceptor & System-1 Classifier -->
        <mxCell id="stage2" value="&lt;b style='color:#F59E0B;'&gt;STAGE 2: LAYA SYSTEM-1 SUBWORD CASCADE&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#F59E0B;strokeWidth=2;fontColor=#F8FAFC;rounded=1;arcSize=6;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="380" y="90" width="340" height="420" as="geometry" />
        </mxCell>
        <mxCell id="laya_interceptor" value="&lt;b&gt;Adversarial Ambiguity Interceptor&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;Microsecond CPU fast-path filter&lt;br&gt;Zero-overhead token regex &amp;amp; intent triage&lt;br&gt;&lt;b style='color:#F59E0B;'&gt;SLA &amp;lt; 25 ms • Observed: 0.365 ms p50&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#D97706;fontColor=#FBBF24;align=left;spacingLeft=10;" vertex="1" parent="stage2">
          <mxGeometry x="15" y="40" width="310" height="75" as="geometry" />
        </mxCell>
        <mxCell id="laya_model" value="&lt;b&gt;Real-Estate Laya Subword Classifier&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;Subword TF-IDF n-grams + Platt Calibration&lt;br&gt;4 Evaluation Heads:&lt;br&gt;• dnc_refusal (100% cascade accuracy)&lt;br&gt;• action_confirmation (100% cascade accuracy)&lt;br&gt;• objection_class (86.1% resolution)&lt;br&gt;• hallucination_probe (98.3% resolution)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#334155;fontColor=#F8FAFC;align=left;spacingLeft=10;" vertex="1" parent="stage2">
          <mxGeometry x="15" y="130" width="310" height="110" as="geometry" />
        </mxCell>
        <mxCell id="laya_metrics" value="&lt;b&gt;System-1 Benchmark Audit Stats&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;• Expected Calibration Error (ECE): 0.0209&lt;br&gt;• Brier Score: 0.0402 • Speedup: 56.3x&lt;br&gt;• Cohen's Kappa with S2: 0.9912&lt;br&gt;• Cost Savings: 92.06% ($230.16 saved / 1k calls)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#334155;fontColor=#F8FAFC;align=left;spacingLeft=10;" vertex="1" parent="stage2">
          <mxGeometry x="15" y="255" width="310" height="85" as="geometry" />
        </mxCell>
        <mxCell id="laya_badge" value="&lt;span style='font-size:11px; color:#4ADE80;'&gt;✓ Validated on 252 Sealed Test Turns (0 Defect Leakage)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="stage2">
          <mxGeometry x="15" y="370" width="310" height="25" as="geometry" />
        </mxCell>

        <!-- STAGE 3: Confidence Gating Router -->
        <mxCell id="stage3" value="&lt;b style='color:#A855F7;'&gt;STAGE 3: CONFIDENCE GATING ROUTER&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#A855F7;strokeWidth=2;fontColor=#F8FAFC;rounded=1;arcSize=6;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="760" y="90" width="280" height="420" as="geometry" />
        </mxCell>
        <mxCell id="gate_thresholds" value="&lt;b&gt;Dual Threshold Decision Rule&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;High Threshold: &lt;b style='color:#4ADE80;'&gt;τ_H = 0.85&lt;/b&gt;&lt;br&gt;Low Threshold: &lt;b style='color:#F43F5E;'&gt;τ_L = 0.15&lt;/b&gt;&lt;br&gt;Margin Filter: Margin &amp;gt;= 0.70&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#334155;fontColor=#F8FAFC;align=left;spacingLeft=10;" vertex="1" parent="stage3">
          <mxGeometry x="15" y="40" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gate_s1" value="&lt;b style='color:#4ADE80;'&gt;[PASS / FAIL Direct]&lt;/b&gt;&lt;br&gt;&lt;b&gt;System-1 Resolved&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;Score &amp;gt;= τ_H or Score &amp;lt;= τ_L&lt;br&gt;&lt;b&gt;92.06% of turns (232/252)&lt;/b&gt;&lt;br&gt;Cost: $0.00 • Latency: 0.36ms&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#16A34A;fontColor=#F8FAFC;align=left;spacingLeft=10;" vertex="1" parent="stage3">
          <mxGeometry x="15" y="125" width="250" height="95" as="geometry" />
        </mxCell>
        <mxCell id="gate_s2" value="&lt;b style='color:#C084FC;'&gt;[ESCALATE TO JUDGE]&lt;/b&gt;&lt;br&gt;&lt;b&gt;Borderline Ambiguity&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;τ_L &amp;lt; Score &amp;lt; τ_H OR Margin &amp;lt; 0.7&lt;br&gt;&lt;b&gt;7.94% of turns (20/252)&lt;/b&gt;&lt;br&gt;Dispatches to System-2 LLM&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#9333EA;fontColor=#F8FAFC;align=left;spacingLeft=10;" vertex="1" parent="stage3">
          <mxGeometry x="15" y="240" width="250" height="95" as="geometry" />
        </mxCell>
        <mxCell id="gate_zero_defect" value="&lt;span style='font-size:11px; color:#C084FC;'&gt;🛡 Rescues 8 Borderline Defect Cases with Zero Leakage&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="stage3">
          <mxGeometry x="15" y="360" width="250" height="30" as="geometry" />
        </mxCell>

        <!-- STAGE 4: System-2 LLM Judge Escalation -->
        <mxCell id="stage4" value="&lt;b style='color:#EC4899;'&gt;STAGE 4: SYSTEM-2 LLM JUDGE&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#EC4899;strokeWidth=2;fontColor=#F8FAFC;rounded=1;arcSize=6;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="1080" y="90" width="280" height="420" as="geometry" />
        </mxCell>
        <mxCell id="s2_llm" value="&lt;b&gt;Cross-Family LLM Judge&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;Independent model family:&lt;br&gt;Claude 3.5 Sonnet / GPT-4o&lt;br&gt;Only invoked for 7.94% turns&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#334155;fontColor=#F8FAFC;align=left;spacingLeft=10;" vertex="1" parent="stage4">
          <mxGeometry x="15" y="40" width="250" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s2_nonce" value="&lt;b&gt;Randomized XML Nonce Framing&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;&amp;lt;turn_eval nonce=&quot;8f4a...&quot;&amp;gt;&lt;br&gt;Neutralizes prompt injection,&lt;br&gt;delimiter collisions &amp;amp; jailbreaks&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#DB2777;fontColor=#F472B6;align=left;spacingLeft=10;" vertex="1" parent="stage4">
          <mxGeometry x="15" y="130" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="s2_anticheat" value="&lt;b&gt;Frontier Anti-Cheat Protections&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;• AlpacaEval 2.0 length-bias normalization&lt;br&gt;• Position-bias swap verification&lt;br&gt;• Sycophancy / sycophant probe checks&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#334155;fontColor=#F8FAFC;align=left;spacingLeft=10;" vertex="1" parent="stage4">
          <mxGeometry x="15" y="230" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s2_cost" value="&lt;span style='font-size:11px; color:#EC4899;'&gt;Effective Turn Cost: $0.00198 vs $0.0250&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="stage4">
          <mxGeometry x="15" y="350" width="250" height="30" as="geometry" />
        </mxCell>

        <!-- STAGE 5: 3-Layer Evaluation Pyramid & Paired Stats -->
        <mxCell id="stage5" value="&lt;b style='color:#4ADE80;'&gt;STAGE 5: 3-LAYER NON-COMPENSATORY EVALUATION PYRAMID &amp;amp; PAIRED STATS ENGINE&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#4ADE80;strokeWidth=2;fontColor=#F8FAFC;rounded=1;arcSize=6;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="1320" height="380" as="geometry" />
        </mxCell>

        <!-- Layer 1 -->
        <mxCell id="pyramid_l1" value="&lt;b style='color:#F43F5E;'&gt;LAYER 1: DETERMINISTIC ORACLES (Hard Gate • Non-Compensatory)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;• TRAI Do-Not-Call (DNC) Immediate Refusal Check&lt;br&gt;• Invented Tool Action / Phantom WhatsApp Confirmation Detection&lt;br&gt;• Strict Tool Parameter Schema Validation &amp;amp; Boundary Checking&lt;br&gt;&lt;b style='color:#F43F5E;'&gt;RULE: If any Layer 1 oracle fails ➔ HARD GATE REGRESSION (Prompt is Blocked)&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#E11D48;fontColor=#F8FAFC;align=left;spacingLeft=15;" vertex="1" parent="stage5">
          <mxGeometry x="20" y="40" width="620" height="90" as="geometry" />
        </mxCell>

        <!-- Layer 2 -->
        <mxCell id="pyramid_l2" value="&lt;b style='color:#F59E0B;'&gt;LAYER 2: PROPERTY FACT GROUNDING (Property Fact Verifier)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;• Strict RERA ID verification against project_fixtures facts_json (GIN)&lt;br&gt;• Price &amp;amp; Carpet Area numerical grounding with 4-token negation context&lt;br&gt;• Floor rise &amp;amp; Possession date boundary checking&lt;br&gt;• Catches subtle Indian real-estate hallucinations&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#D97706;fontColor=#F8FAFC;align=left;spacingLeft=15;" vertex="1" parent="stage5">
          <mxGeometry x="20" y="145" width="620" height="90" as="geometry" />
        </mxCell>

        <!-- Layer 3 -->
        <mxCell id="pyramid_l3" value="&lt;b style='color:#38BDF8;'&gt;LAYER 3: CROSS-FAMILY RUBRIC JUDGE (System-1 Laya + Escalated System-2)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;• Tone Register &amp;amp; De-escalation under buyer aggression&lt;br&gt;• Hinglish Objection Handling &amp;amp; Information Completeness&lt;br&gt;• Action Confirmation Integrity &amp;amp; Next-step alignment&lt;br&gt;• 100% agreement on critical safety rubrics with pure System-2&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0284C7;fontColor=#F8FAFC;align=left;spacingLeft=15;" vertex="1" parent="stage5">
          <mxGeometry x="20" y="250" width="620" height="90" as="geometry" />
        </mxCell>

        <!-- Paired Statistics Engine -->
        <mxCell id="stats_engine" value="&lt;b style='color:#4ADE80;'&gt;PAIRED STATISTICAL GATING ENGINE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;&lt;b&gt;1. K = 1 Paired Trials (Single-Trial Experiments):&lt;/b&gt;&lt;br&gt;• Exact Binomial McNemar Test (Two-Sided) on paired 2x2 contingency table&lt;br&gt;• Newcombe Method 10 Paired Score Confidence Interval on Risk Difference (Δp)&lt;br&gt;• Cohen's h effect size • Zero naive average metric leakage&lt;br&gt;&lt;br&gt;&lt;b&gt;2. K &amp;gt; 1 Repeated Measures (Multi-Trial Experiments):&lt;/b&gt;&lt;br&gt;• Paired Wilcoxon Signed-Rank Test on paired scenario trial scores&lt;br&gt;• Two-Stage Cluster BCa Bootstrap (10,000 resamples) for non-parametric CIs&lt;br&gt;• Rank Biserial Correlation r • Holm-Bonferroni Family-Wise Error Rate Control&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Statistical Gating Rules:&lt;/b&gt;&lt;br&gt;• Status PASSED: Δp &amp;gt; 0, p &amp;lt; 0.05, 0 hard gate regressions&lt;br&gt;• Status REGRESSED: Δp &amp;lt; 0 or any hard gate regression&lt;br&gt;• Status INCONCLUSIVE_UNDERPOWERED: N &amp;lt; required power sample size&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#16A34A;fontColor=#F8FAFC;align=left;spacingLeft=15;" vertex="1" parent="stage5">
          <mxGeometry x="660" y="40" width="640" height="300" as="geometry" />
        </mxCell>

        <!-- PIPELINE FLOW EDGES -->
        <!-- Stage 1 to Stage 2 -->
        <mxCell id="e1_2" value="Simulated Turns" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#38BDF8;strokeWidth=2;fontColor=#38BDF8;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" source="stage1" target="stage2" parent="1">
