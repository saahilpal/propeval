        <mxCell id="e2_3" value="Scores &amp;amp; Confidences" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F59E0B;strokeWidth=2;fontColor=#F59E0B;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" source="stage2" target="stage3" parent="1">
          <mxGeometry relative="1" as="geometry" />
